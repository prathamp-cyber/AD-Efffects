# AD-Efffects Environment Variables
#
# Copy this file to .env.local for local development or configure the same
# names in your hosting provider. Never commit .env.local or real secret values.
# These variables are server-only. Do not rename them with NEXT_PUBLIC_.

# Admin panel login for /admin.
# ADMIN_PASSWORD may be a plaintext secret or the app's scrypt salt:hash format.
# Prefer a long random password stored only in your environment manager.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Super admin login for /nexora. If either value is empty, super admin login is disabled.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# 64+ random characters used to sign session cookies.
# Example generator:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Optional Upstash/Vercel KV REST credentials for server-side persistence and rate limits.
# These are service tokens and must stay server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=
